# 仅用于本地演示；不要提交实际环境密码。
MYSQL_ROOT_PASSWORD=dingdong-demo-root
DEMO_PASSWORD=DingDong123!
JWT_SECRET=dingdong-demo-signing-key-change-me-32bytes
PAYMENT_WINDOW=120s
# M2 默认限流与工作预算。故障开关仅供独立演示环境使用。
USER_RATE_BURST=3
USER_RATE_PER_SECOND=1
ACTIVITY_RATE_BURST=500
ACTIVITY_RATE_PER_SECOND=100
CACHE_ORIGIN_LIMIT=16
WORKER_CONCURRENCY=8
RETRY_LIMIT=20
DEMO_FAULTS_ENABLED=false
# 默认代理不可达时，可改为 https://goproxy.cn,direct；不会修改全局 Go 设置。
GOPROXY=https://proxy.golang.org,direct
